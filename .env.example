# LinkedIn session from your own logged-in browser. Never commit real values.
# How to get them: DevTools → Application → Cookies → linkedin.com
#   - li_at
#   - JSESSIONID (include value with or without quotes)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
ALLOWED_ORIGINS=

LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
